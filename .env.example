# =============================================================================
# AI Knowledge Tracing — environment variables
# =============================================================================
# Copy to .env and fill in the secrets. Pick ONE of the LLM provider profiles
# below; leave the others commented out.

# =============================================================================
# LLM provider (OpenAI-compatible HTTP API)
# =============================================================================

# --- Profile A: OpenAI ---
LLM_API_KEY=sk-...                          # https://platform.openai.com/api-keys
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini                       # cheap and capable. ≈$0.0015 / 1k tokens output

# --- Profile B: OpenRouter (many models, single key) ---
# LLM_API_KEY=sk-or-...                     # https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-haiku

# --- Profile C: DeepSeek (cheap) ---
# LLM_API_KEY=sk-...                        # https://platform.deepseek.com/api_keys
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Profile D: YandexGPT (Yandex Cloud) ---  ← рабочий профиль этого проекта
# LLM_API_KEY=AQVN...                       # API-ключ сервисного аккаунта llm-test (роль ai.languageModels.user)
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest   # подставь folder_id своего каталога; -lite дешевле
# LLM_AUTH_SCHEME=api-key                   # статический ключ SA → заголовок "Api-Key". IAM-токен (t1...) → bearer/пусто

# --- Profile E: Yandex Eliza (legacy corporate, intranet only) ---
# SOY_TOKEN=...                             # legacy alias for LLM_API_KEY
# LLM_BASE_URL=https://api.eliza.yandex.net/raw/openai/v1
# LLM_MODEL=gpt-5.4-nano
# LLM_CA_BUNDLE=/app/data/ca-bundle.pem     # corporate CA, set only if needed

# Common LLM tuning (apply to all profiles)
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1200                         # hard cap on output
LLM_MAX_INPUT_CHARS=14000                   # hard cap on prompt size (≈3.5k tokens)

# =============================================================================
# Cost guard
# =============================================================================
# Disk cache for deterministic LLM calls (bank-explain, theme-summary).
# After first generation, same input → instant zero-cost response.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=data/llm_cache

# Rate limit: requests per minute per IP. 0 = disabled.
RATE_LIMIT_PER_MIN=30

# =============================================================================
# Embeddings (local, no external API)
# =============================================================================
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# =============================================================================
# Paths (inside container or dev workdir)
# =============================================================================
GRAPH_PATH=out/LearningChunkGraph_longrange.json
CONCEPT_DICT_PATH=out/ConceptDictionary.json
THEORY_MD_PATH=theory_economics.md
CHROMA_PATH=data/chroma
TOPICS_PATH=data/topics.json
DATA_DIR=data
EXAMS_DIR=data/exams

# =============================================================================
# Reranker (cross-encoder)
# =============================================================================
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_K_IN=20
RERANKER_TOP_K_OUT=10
RERANKER_SCORE_BLEND=0.5

# =============================================================================
# Retrieval
# =============================================================================
RETRIEVER_TOP_K_GRAPH=4
RETRIEVER_TOP_K_MD=4
MD_CHUNK_TARGET_TOKENS=800
MD_CHUNK_OVERLAP_TOKENS=100

# =============================================================================
# App
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# Test helper: skip all LLM calls (returns extractive fallbacks)
# =============================================================================
SKIP_LLM=false
