# --- LLM (Yandex Eliza, OpenAI-compatible) ---
# REQUIRED. Obtain SOY token in your shell and export it:
#   export SOY_TOKEN=$(...)  # from your environment
# Then docker-compose forwards it via env_file expansion.
SOY_TOKEN=${SOY_TOKEN}

LLM_BASE_URL=https://api.eliza.yandex.net/raw/openai/v1
LLM_MODEL=gpt-5.4-nano
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1200

# Yandex internal CA bundle (PEM). On macOS the host already has the cert in
# Keychain but Python's certifi doesn't see it; we generate a custom bundle
# at scripts/prepare_ca_bundle.sh and mount it into the container.
LLM_CA_BUNDLE=/app/data/ca-bundle.pem

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Paths (inside container) ---
GRAPH_PATH=/app/out/LearningChunkGraph_longrange.json
CONCEPT_DICT_PATH=/app/out/ConceptDictionary.json
THEORY_MD_PATH=/app/theory_economics.md
CHROMA_PATH=/app/data/chroma
TOPICS_PATH=/app/data/topics.json
DATA_DIR=/app/data

# --- Topics (Scenario B) ---
N_TOPICS=15
PERFECT_SCORE_TOPICS_LIMIT=8

# --- Graph BFS ---
GRAPH_BFS_DEPTH=2
STUDY_PLAN_RELATED_LIMIT=8

# --- Retrieval ---
RETRIEVER_TOP_K_GRAPH=4
RETRIEVER_TOP_K_MD=4
MD_CHUNK_TARGET_TOKENS=800
MD_CHUNK_OVERLAP_TOKENS=100

# --- Reranker (cross-encoder) ---
# Set to false to disable (saves ~150MB model + ~200ms per question).
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_K_IN=20
RERANKER_TOP_K_OUT=10
RERANKER_SCORE_BLEND=0.5

# --- Misc ---
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
