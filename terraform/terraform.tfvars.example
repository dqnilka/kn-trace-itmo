# Скопируй в terraform.tfvars и заполни. terraform.tfvars в .gitignore.
#
# Где взять значения:
#   cloud_id, folder_id  → console.cloud.yandex.ru → верхняя панель «Облако» + «Каталог»
#   sa_key_file          → см. SETUP.md шаг 2 — путь к JSON ключу
#   llm_api_key          → у выбранного LLM-провайдера (OpenAI/OpenRouter/DeepSeek)
#   bucket_name          → глобально-уникальное имя, например "kt-frontend-yourname"

cloud_id    = "b1g..."                          # console.cloud.yandex.ru → «Облако»
folder_id   = "b1g..."                          # каталог проекта (ai-knowledge-tracing)
sa_key_file = "./kt-deployer-key.json"

# --- LLM ---
# Рабочий профиль проекта — YandexGPT (folder проекта, SA llm-test):
llm_api_key     = "AQVN..."                                   # API-ключ сервисного аккаунта llm-test (роль ai.languageModels.user)
llm_base_url    = "https://llm.api.cloud.yandex.net/v1"
llm_model       = "gpt://<folder_id>/yandexgpt/latest"        # подставь folder_id своего каталога
llm_auth_scheme = "api-key"                                   # статический ключ SA → заголовок "Api-Key". Для IAM-токена — "bearer" или ""
# Альтернативы (любой OpenAI-совместимый провайдер):
# llm_api_key="sk-..." llm_base_url="https://api.openai.com/v1"   llm_model="gpt-4o-mini"
# llm_api_key="sk-..." llm_base_url="https://api.deepseek.com/v1" llm_model="deepseek-chat"

# --- Frontend bucket ---
bucket_name = "kt-frontend-CHANGE-ME"

# --- Tuning (опционально) ---
# container_memory_mb   = 2048
# container_cores       = 1
# container_concurrency = 4
# rate_limit_per_min    = 30
# skip_llm              = false  # true — для smoke-проверки инфры без трат
