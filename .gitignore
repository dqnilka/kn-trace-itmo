# =============================================================================
# Python
# =============================================================================
.venv/
venv/
.python-version
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/

# =============================================================================
# Node / Frontend
# =============================================================================
node_modules/
frontend/dist/
frontend/vite.log
*.tsbuildinfo

# =============================================================================
# Secrets — НИКОГДА не коммитить
# =============================================================================
.env
.env.local
.env.*.local
terraform/terraform.tfvars
terraform/*.tfvars
!terraform/terraform.tfvars.example
terraform/*-key.json
terraform/*.key.json

# =============================================================================
# Terraform state
# =============================================================================
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl
terraform/crash.log
terraform/crash.*.log

# =============================================================================
# Runtime data
# =============================================================================
# Игнорируем всё в data/ ПО УМОЛЧАНИЮ — потом исключения для baked-in артефактов.
data/*

# Исключения: эти артефакты нужны для prod-сборки (Dockerfile.prod COPY их),
# а также для CI (actions/checkout тянет только git-tracked).
!data/chroma
!data/exams

# Внутри data/exams — игнорируем runtime-побочки (per-user mastery, event log,
# LLM-cache суммари, логи pipeline). Источники истины (bank/graph/theory)
# коммитим.
data/exams/*/users/
data/exams/*/events.jsonl
data/exams/*/theme_summaries/
data/exams/*/runs/
data/exams/*/backups/
data/exams/*/sources/

# LLM-cache регенерируется, не коммитим
data/llm_cache/

# =============================================================================
# IDE / Editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS metadata
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Logs & test artifacts
# =============================================================================
*.log
tests/_artifacts/
out/*.log

# =============================================================================
# Legacy / archived response fixtures
# Эти конкретные json — артефакты старого pipeline, см. README.
# =============================================================================
examples/scenario_a_response.json
examples/scenario_a_response.before_fix.json
examples/scenario_a_response.fix*.json
examples/scenario_a_response.rerank_blend*.json

# =============================================================================
# Temp / scratch
# =============================================================================
t.md
*.tmp
*.bak
