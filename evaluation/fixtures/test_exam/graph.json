    {"id": "co:finansovyj-rynok", "type": "Concept", "term": "Финансовый рынок", "definition": "Совокупность отношений по поводу распределения и перераспределения денежных средств", "aliases": ["финансовый рынок", "финансовые рынки"]},
    {"id": "co:czennaya-bumaga", "type": "Concept", "term": "Ценная бумага", "definition": "Документ удостоверяющий имущественные права", "aliases": ["ценные бумаги", "ЦБ"]},
    {"id": "co:obligaciya", "type": "Concept", "term": "Облигация", "definition": "Долговая эмиссионная ценная бумага", "aliases": ["облигации", "бонды"]},
    {"id": "co:akciya", "type": "Concept", "term": "Акция", "definition": "Эмиссионная ценная бумага закрепляющая права на участие в управлении", "aliases": ["акции", "share"]},
    {"id": "co:proizvodnyj-instrument", "type": "Concept", "term": "Производный инструмент", "definition": "Финансовый инструмент стоимость которого зависит от базового актива", "aliases": ["дериватив", "производные инструменты"]},
    {"id": "co:fyuchers", "type": "Concept", "term": "Фьючерс", "definition": "Производный финансовый инструмент стандартизированный биржевой контракт", "aliases": ["фьючерсный контракт", "futures"]},
    {"id": "co:opcion", "type": "Concept", "term": "Опцион", "definition": "Контракт дающий право но не обязательство купить или продать актив", "aliases": ["опционный контракт", "option"]},
    {"id": "co:diskontirovanie", "type": "Concept", "term": "Дисконтирование", "definition": "Приведение будущей стоимости денежных потоков к текущему моменту", "aliases": ["дисконт", "discounting"]},
    {"id": "co:procentnaya-stavka", "type": "Concept", "term": "Процентная ставка", "definition": "Цена использования заемных средств выраженная в процентах", "aliases": ["ставка процента", "interest rate"]},
    {"id": "co:risk-finansovyj", "type": "Concept", "term": "Финансовый риск", "definition": "Вероятность возникновения финансовых потерь", "aliases": ["финансовые риски", "риск"]},
    {"id": "co:diversifikaciya", "type": "Concept", "term": "Диверсификация", "definition": "Распределение инвестиций между различными активами для снижения риска", "aliases": ["диверсификация портфеля"]},
    {"id": "co:portfel-investicij", "type": "Concept", "term": "Портфель инвестиций", "definition": "Набор финансовых инструментов принадлежащих инвестору", "aliases": ["инвестиционный портфель", "портфель"]},
    {"id": "co:birzhevoj-rynok", "type": "Concept", "term": "Биржевой рынок", "definition": "Организованный рынок с централизованным проведением торгов", "aliases": ["биржа", "фондовая биржа"]},
    {"id": "co:broker", "type": "Concept", "term": "Брокер", "definition": "Профессиональный участник рынка выполняющий поручения клиентов", "aliases": ["брокерская деятельность", "брокеридж"]},
    {"id": "co:emissiya", "type": "Concept", "term": "Эмиссия ценных бумаг", "definition": "Выпуск в обращение ценных бумаг эмитентом", "aliases": ["эмиссия", "выпуск ценных бумаг"]}
